{
  "name": "meteor-pilot-mobile",
  "private": true,
  "version": "1.0.0",
  "description": "Google Play and App Store builds of Meteor Pilot (Capacitor). The game itself is ../index.html.",
  "meteorPilot": {
    "webUrl": "https://jimsky90.github.io/meteor-pilot/",
    "appIdConfirmed": false,
    "iPhoneOnly": true,
    "backgroundColor": "#070a1a"
  },
  "scripts": {
    "build": "node scripts/build-www.mjs",
    "assets": "capacitor-assets generate --iconBackgroundColor \"#070a1a\" --iconBackgroundColorDark \"#070a1a\" --splashBackgroundColor \"#070a1a\" --splashBackgroundColorDark \"#070a1a\"",
    "patch-native": "node scripts/patch-native.mjs",
    "check-config": "node scripts/check-config.mjs",
    "prepare-android": "npm run build && (test -d android || npx cap add android) && npm run assets -- --android && npm run patch-native -- android && npx cap sync android",
    "prepare-ios": "npm run build && (test -d ios || npx cap add ios) && npm run assets -- --ios && npm run patch-native -- ios && npx cap sync ios",
    "test": "python3 test_build.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.0",
    "@fontsource/atkinson-hyperlegible": "^5.0.0",
    "@fontsource/chakra-petch": "^5.0.0"
  }
}
